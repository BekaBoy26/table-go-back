DATABASE_URL=postgresql://user:password@your-db-host:5432/postgres
PORT=3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://table-go-back.onrender.com/auth/google/callback

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# The deployed frontend: CORS origin and where Google sign-in returns to
FRONTEND_URL=https://your-frontend-domain
# Comma-separated; grants ADMIN to these emails once verified (Google sign-in)
ADMIN_EMAILS=
# Admin with email + password sign-in, created/updated on startup (optional)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Gemini (AI restaurant search); without a key the search falls back to keyword matching
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# 2GIS place search for the admin map
DGIS_API_KEY=
